# Copy to .env and fill in before running: cp .env.example .env

# PostgreSQL (used by postgres service and backend DATABASE_URL)
POSTGRES_PASSWORD=change_me_strong_password

# JWT signing key — generate with: openssl rand -hex 32
SECRET_KEY=change_me_random_secret_key

# Database schema (migrations use "collations" — do not change unless you regenerate migrations)
DB_SCHEMA=collations

# URL the browser uses to reach the backend API (baked into frontend at build time)
# Local default: http://localhost:8000
# If BACKEND_PORT is changed, update this too and rebuild frontend: docker compose build frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated origins allowed by backend CORS — MUST match the URL you open in the browser
# If FRONTEND_PORT=3001, use: CORS_ORIGINS=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# Host ports on your machine (optional overrides)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Initial account passwords. Admin defaults to login admin / password admin.
# Set BOOTSTRAP_ADMIN_PASSWORD to override it before the first launch.
# Empty user1/user2 passwords skip those accounts. Existing credentials are never reset.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_USER1_PASSWORD=
BOOTSTRAP_USER2_PASSWORD=
